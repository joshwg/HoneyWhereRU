# systemd unit for the Whereru server (a single compiled Go binary).
#
# Copy to /etc/systemd/system/whereru.service, adjust User/WorkingDirectory
# if you didn't use the paths from the README, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now whereru

[Unit]
Description=Whereru location relay server
After=network.target

[Service]
Type=simple
User=whereru
WorkingDirectory=/opt/whereru
# Same file the binary reads itself (loadDotEnv). The leading "-" makes it
# optional so a missing file doesn't stop the service from starting.
EnvironmentFile=-/opt/whereru/.env
ExecStart=/opt/whereru/whereru-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/whereru/data

[Install]
WantedBy=multi-user.target
