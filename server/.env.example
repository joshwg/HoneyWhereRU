# Comma-separated list of token:name pairs, one per person (works fine for
# small groups, e.g. up to 6 -- there's no hard limit, this just isn't built
# for a large number of users).
# Generate a short random token per person (12-48 chars allowed; 12 shown, no look-alike characters):
#   tr -dc 'abcdefghjkmnpqrstuvwxyz23456789' </dev/urandom | head -c 12; echo
# Keep these secret -- anyone with a token can see (and spoof) that person's location.
USERS=REPLACE_WITH_RANDOM_TOKEN:Josh,REPLACE_WITH_RANDOM_TOKEN:Wife,REPLACE_WITH_RANDOM_TOKEN:Mom

PORT=3000

# Optional: where the SQLite file lives. Defaults to ./data/whereru.db
# (relative to the whereru-server binary's working directory) if unset.
# DB_PATH=/opt/whereru/data/whereru.db
